# Offline by default. Copy to backend/.env; never put a real key in this file.
# local allows an unauthenticated same-machine demo; hosted requires a backend
# token and accepts declared synthetic eye input only. The image defaults hosted.
VR_RUNTIME_MODE=local
VR_GEMINI_ENABLED=false
# Explicit server opt-in for participant-consented aggregate metrics/ratings.
# Requests must also declare consented_summary; raw samples/free text are never sent.
VR_ALLOW_PARTICIPANT_CLOUD=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Set verified model prices (USD / million tokens) before enabling Gemini.
# For verified unpaid quota, explicitly set both rates to 0.
VR_INPUT_PRICE_PER_MILLION=
VR_OUTPUT_PRICE_PER_MILLION=
VR_GEMINI_BUDGET_USD=0
VR_GEMINI_MAX_ATTEMPTS_PER_DAY=20
VR_GEMINI_TIMEOUT_SECONDS=12

# Set a separate random token before sharing the backend on a LAN.
# Clients then send Authorization: Bearer <token>. Never reuse GEMINI_API_KEY.
VR_BACKEND_ACCESS_TOKEN=
VR_MAX_REQUEST_BYTES=16384
