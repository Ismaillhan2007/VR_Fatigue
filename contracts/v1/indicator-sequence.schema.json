{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vr-fatigue:indicator-sequence:v1",
  "title": "Synthetic test-only normalized inputs for indicator temporal math",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "data_source", "test_only", "alpha", "start_timestamp_us", "window_duration_us", "raw_values", "expected_values", "expected_levels", "expected_events", "expected_active", "expected_high_counts"],
  "properties": {
    "schema_version": {"const": "indicator-sequence.v1"}, "data_source": {"const": "synthetic"}, "test_only": {"const": true},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "start_timestamp_us": {"$ref": "urn:vr-fatigue:eye-session:v1#/$defs/timestamp"},
    "window_duration_us": {"const": 20000000},
    "raw_values": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/value"}},
    "expected_values": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/value"}},
    "expected_levels": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"enum": ["low", "moderate", "high", "unavailable"]}},
    "expected_events": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"enum": ["none", "offer_break", "released"]}},
    "expected_active": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "boolean"}},
    "expected_high_counts": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "integer", "minimum": 0, "maximum": 3}}
  },
  "$defs": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
}
